# Copy to .env and fill in. Never commit .env.

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ermis
# or Atlas: mongodb+srv://USER:PASS@cluster.../ermis

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Local: http://localhost:5173
# Production HTTPS: https://your-domain.com  (must match the browser URL)
CLIENT_ORIGIN=http://localhost:5173
# Set on EC2 so refresh cookies use Secure + SameSite=Strict
# NODE_ENV=production

# --- S3 (Priority 1: durable record files) ---
# Leave S3_BUCKET empty to store files on local disk under ermis-backend/uploads/
# When set, uploads go to a private S3 bucket (same region as EC2 recommended).
#
# AWS console checklist:
# 1. Create a private bucket (Block Public Access ON)
# 2. IAM user or EC2 instance role with s3:PutObject, GetObject, DeleteObject on that bucket
# 3. Fill the vars below (keys not needed if using an EC2 instance role)

S3_BUCKET=
AWS_REGION=af-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

PORT=5000
